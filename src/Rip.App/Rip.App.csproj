<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Rip</AssemblyName>
    <RootNamespace>Rip.App</RootNamespace>
    <AssemblyTitle>Rip</AssemblyTitle>
    <Product>Rip</Product>
    <ApplicationIcon>Assets/Rip.ico</ApplicationIcon>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">https://github.com/ElliottHitch/Rip</UpdateRepository>
    <Description>General-purpose single-video downloader with optional UniFi compatibility output.</Description>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>linux-arm64;linux-x64;win-x64</RuntimeIdentifiers>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>1.0.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <AvaloniaResource Include="Assets/**" />
    <Content Include="Setup/tool-bootstrap.json" Link="tool-bootstrap.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Velopack" />
    <ProjectReference Include="../Rip.Core/Rip.Core.csproj" />
    <ProjectReference Include="../Rip.Infrastructure/Rip.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
