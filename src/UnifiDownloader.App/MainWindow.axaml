<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UnifiDownloader.App.MainWindow"
        Title="YouTube Downloader"
        Width="760"
        Height="900"
        MinWidth="560"
        MinHeight="700">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" Spacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="YouTube Downloader" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="One video per run" Opacity="0.72" />
      </StackPanel>

      <GroupBox Header="Request">
        <StackPanel Margin="12" Spacing="10">
          <TextBlock Text="Video URL" FontWeight="SemiBold" />
          <TextBox Name="VideoUrlBox" AutomationProperties.Name="Video URL"
                   AutomationProperties.HelpText="Enter exactly one absolute HTTP(S) video address."
                   Text="{Binding VideoUrl, Mode=TwoWay}" PlaceholderText="https://..." />
          <TextBlock Text="Operation" FontWeight="SemiBold" />
          <ComboBox AutomationProperties.Name="Operation" ItemsSource="{Binding Operations}"
                    AutomationProperties.HelpText="Select exactly one operation: Metadata, Video, or Audio."
                    SelectedItem="{Binding SelectedOperation, Mode=TwoWay}" />
          <TextBlock Text="Metadata resolves safe information only; Video downloads video; Audio downloads audio." Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Output">
        <StackPanel Margin="12" Spacing="10">
          <TextBlock Text="Output folder" FontWeight="SemiBold" />
          <TextBox AutomationProperties.Name="Output folder"
                   AutomationProperties.HelpText="{Binding OutputControlsHelpText}"
                   IsEnabled="{Binding OutputControlsEnabled}"
                   Text="{Binding OutputFolder, Mode=TwoWay}" />
          <Button Content="Choose Output Folder" AutomationProperties.Name="Choose Output Folder"
                  AutomationProperties.HelpText="{Binding FolderChooserHelpText}"
                  IsEnabled="{Binding CanChooseOutputFolder}" Click="ChooseOutputFolderClicked" />
          <TextBlock Text="{Binding FolderPickerFallbackText}" Opacity="0.72" TextWrapping="Wrap" />
          <TextBlock Text="File stem" FontWeight="SemiBold" />
          <TextBox AutomationProperties.Name="File stem"
                   AutomationProperties.HelpText="{Binding OutputControlsHelpText}"
                   IsEnabled="{Binding OutputControlsEnabled}"
                   Text="{Binding FileStem, Mode=TwoWay}" />
          <CheckBox Content="Make output UniFi-compatible (MP4 / H.264 / AAC)"
                    AutomationProperties.Name="Make output UniFi-compatible"
                    AutomationProperties.HelpText="Off by default. When enabled, converts to the bounded UniFi MP4 compatibility profile."
                    IsChecked="{Binding MakeUnifiCompatible, Mode=TwoWay}"
                    IsEnabled="{Binding OutputControlsEnabled}" />
          <TextBlock Text="Off: preserve the selected source codecs in a lossless Matroska container. On: use the bounded MP4 / H.264 / AAC compatibility profile." Opacity="0.72" TextWrapping="Wrap" />
          <TextBlock Text="Output settings are not used for metadata." Opacity="0.72" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Browser session">
        <StackPanel Margin="12" Spacing="10">
          <CheckBox Content="Use browser session" AutomationProperties.Name="Use browser session"
                    AutomationProperties.HelpText="Off by default; applies only to this run."
                    IsChecked="{Binding UseBrowserSession, Mode=TwoWay}" />
          <ComboBox AutomationProperties.Name="Browser"
                    AutomationProperties.HelpText="Required only when consent is on; no profile path is accepted."
                    ItemsSource="{Binding SupportedBrowsers}" SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}"
                    IsEnabled="{Binding BrowserSelectionEnabled}" />
          <TextBlock Text="{Binding BrowserSessionHelp}" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Environment">
        <StackPanel Margin="12" Spacing="10">
          <ItemsControl ItemsSource="{Binding Capabilities}" AutomationProperties.Name="Environment capability summary"
                        AutomationProperties.HelpText="Safe local capability statuses; testing does not start a download.">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Status}" />
                  <TextBlock Text="{Binding Description}" Opacity="0.72" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Test Environment" AutomationProperties.Name="Test Environment"
                  AutomationProperties.HelpText="Reports safe local capability statuses without starting a download."
                  Click="TestEnvironmentClicked" />
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Start" AutomationProperties.Name="Start"
                AutomationProperties.HelpText="{Binding StartHelpText}"
                IsEnabled="{Binding CanStart}" Click="StartClicked" />
        <Button Content="Cancel" AutomationProperties.Name="Cancel"
                AutomationProperties.HelpText="Requests bounded cancellation; work may take time to stop."
                IsEnabled="{Binding CanCancel}" Click="CancelClicked" />
      </StackPanel>
      <TextBlock Text="{Binding ValidationMessage}" Foreground="Orange" TextWrapping="Wrap" />

      <GroupBox Header="Activity">
        <StackPanel Margin="12" Spacing="10">
          <TextBlock Text="Current stage" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StageText}" AutomationProperties.Name="Current stage"
                     AutomationProperties.HelpText="Safe lifecycle stage for the current request." FontSize="18" />
          <ProgressBar AutomationProperties.Name="Download progress" Minimum="0" Maximum="1"
                       AutomationProperties.HelpText="Determinate progress when supplied; otherwise the progress is indeterminate while work is active."
                       Value="{Binding ProgressFraction}" IsVisible="{Binding HasProgress}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" Height="8" />
          <TextBlock Text="{Binding ActivityText}" AutomationProperties.Name="Current activity" TextWrapping="Wrap" />
          <TextBlock Text="Activity log" AutomationProperties.Name="Activity log" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding ActivityLog}" MinHeight="100" MaxHeight="220"
                   AutomationProperties.Name="Activity log"
                   AutomationProperties.HelpText="Bounded safe activity entries; raw diagnostics are not shown.">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Completion">
        <StackPanel Margin="12" Spacing="10">
          <TextBlock Text="{Binding MetadataSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CompletionText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="OrangeRed" TextWrapping="Wrap" />
          <Button Content="Open in Browser" AutomationProperties.Name="Open in Browser"
                  AutomationProperties.HelpText="Opens the verified local output through the operating system handler."
                  IsEnabled="{Binding CanOpenInBrowser}" Click="OpenInBrowserClicked" />
          <Button Content="Start New Run" AutomationProperties.Name="Start New Run"
                  AutomationProperties.HelpText="Resets terminal form and run-scoped session state."
                  IsEnabled="{Binding IsTerminal}" Click="StartNewRunClicked" />
        </StackPanel>
      </GroupBox>

      <TextBlock Text="{Binding Announcement}" AutomationProperties.Name="Status"
                 AutomationProperties.HelpText="Safe status announcement for meaningful lifecycle changes." TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusText}" AutomationProperties.Name="Status detail"
                 AutomationProperties.HelpText="Current safe operation status." Opacity="0.72" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
