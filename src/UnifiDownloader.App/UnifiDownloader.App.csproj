<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>UnifiDownloader.App</AssemblyName>
    <RootNamespace>UnifiDownloader.App</RootNamespace>
    <AssemblyTitle>YouTube Downloader</AssemblyTitle>
    <Product>YouTube Downloader</Product>
    <Description>General-purpose single-video downloader with optional UniFi compatibility output.</Description>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>linux-arm64;linux-x64;win-x64</RuntimeIdentifiers>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>1.0.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnifiDownloader.Core/UnifiDownloader.Core.csproj" />
    <ProjectReference Include="../UnifiDownloader.Infrastructure/UnifiDownloader.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
