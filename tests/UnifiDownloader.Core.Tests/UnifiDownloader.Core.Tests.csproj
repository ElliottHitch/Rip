<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>UnifiDownloader.Core.Tests</AssemblyName>
    <RootNamespace>UnifiDownloader.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- xUnit's underscore test naming is intentional; production code keeps all analyzers enabled. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UnifiDownloader.Core/UnifiDownloader.Core.csproj" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
</Project>
